# ==========================================
# Backend Configuration (FastAPI)
# ==========================================

# Your Firebase Project ID (found in Firebase Console > Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Absolute or relative path to your downloaded Firebase Service Account JSON private key file.
# Example: ./serviceAccountKey.json or C:/path/to/serviceAccountKey.json
# If using GOOGLE_APPLICATION_CREDENTIALS environment variable, you can leave this empty.
FIREBASE_CREDENTIALS_PATH=

# Allowed CORS origins (comma-separated, typically the Next.js frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Qwen LLM Configuration (Milestone 2)
# ==========================================
# Get your API key from Alibaba Cloud Model Studio / DashScope Console:
# https://dashscope.console.aliyun.com/ or https://bailian.console.alibabacloud.com/
QWEN_API_KEY=sk-your-qwen-api-key

# DashScope OpenAI-compatible API base URL (defaults to international endpoint):
# International: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# China: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Qwen model identifier (e.g. qwen-plus, qwen-turbo, qwen-max, qwen2.5-72b-instruct)
QWEN_MODEL=qwen-plus

# The embedding backend runs separately and is configured in frontend/.env.local.
