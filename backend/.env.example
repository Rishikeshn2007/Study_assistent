# ==========================================
# Backend Configuration (FastAPI)
# ==========================================

# Your Firebase Project ID (found in Firebase Console > Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Absolute or relative path to your downloaded Firebase Service Account JSON private key file.
# Example: ./serviceAccountKey.json or C:/path/to/serviceAccountKey.json
# If using GOOGLE_APPLICATION_CREDENTIALS environment variable, you can leave this empty.
FIREBASE_CREDENTIALS_PATH=

# Allowed CORS origins (comma-separated, typically the Next.js frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
